NODE_ENV=development
PORT=3001

# --- Local: Supabase (Auth + DB dari Docker) ---
# 1. Jalankan: npm run supabase:start
# 2. Lalu: npm run supabase:status  -> salin DB URL dan "JWT secret" (bukan anon key!) ke SUPABASE_JWT_SECRET
# 3. Migrate: npm run migrate
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# WAJIB: Harus sama persis dengan JWT Secret dari Supabase (bukan anon key). Kalau salah = 401 Invalid token.
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_status

# --- Local: Docker Compose (hanya Postgres, tanpa Auth) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rapsproject?schema=public
# SUPABASE_JWT_SECRET=local-dev-secret-change-in-production

# --- Production (Supabase Cloud) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# CORS: origin frontend (golden = Vite default 5173)
CORS_ORIGIN=http://localhost:5173

